      {
        "@language": "en",
        "@value": "has previous step"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subPropertyOf": [
      {
        "@id": "http://www.ontologydesignpatterns.org/cp/owl/sequence.owl#directlyFollows"
      }
    ],
    "http://www.w3.org/2003/06/sw-vocab-status/ns#term_status": [
